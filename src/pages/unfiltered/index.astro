---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contact } from '../../data/profile';
import { kinds, unfilteredPosts } from '../../data/unfiltered';

// Instagram-profile style grid of photo posts; each square opens the post
const posts = await unfilteredPosts();
const used = Object.entries(kinds).filter(([k]) => posts.some((p) => p.data.kind === k));
---
<BaseLayout title="Unfiltered" description="Food I cook, places I go and everyday moments, shared by Mehmet Faruk Gül. No filters, no algorithm.">
  <h1 class="page-title">Unfiltered</h1>
  <p class="lede intro">No filters, no algorithm. Food I cook, places I go and everyday moments.</p>

  {posts.length > 0 ? (
    <>
      {used.length > 1 && (
        <div class="chips" role="group" aria-label="Filter posts">
          <button type="button" data-kind="all" aria-pressed="true">All</button>
          {used.map(([k, v]) => <button type="button" data-kind={k} aria-pressed="false">{v.emoji} {v.label}</button>)}
        </div>
      )}
      <ul class="grid">
        {posts.map((p) => {
          const [cover] = p.data.photos;
          return (
            <li data-kind={p.data.kind}>
              <a href={`/unfiltered/${p.id}`} aria-label={p.data.place ?? cover.alt ?? 'Photo post'}>
                <img src={cover.src} alt={cover.alt ?? ''} loading="lazy" decoding="async" />
                {p.data.photos.length > 1 && <svg class="multi" viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="2" width="15" height="15" rx="3" /><path d="M17 19v0a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V10a3 3 0 0 1 3-3" /></svg>}
                {p.data.place && <span class="place">📍 {p.data.place}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </>
  ) : (
    <p class="empty">
      The first photos are on their way. Meanwhile, say hi on
      {contact.instagram ? <a href={contact.instagram} rel="noopener">Instagram</a> : 'Instagram'}.
    </p>
  )}
</BaseLayout>

<script>
  // Filter chips: show only posts of the chosen kind
  const chips = document.querySelectorAll<HTMLButtonElement>('.chips button');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    const kind = chip.dataset.kind;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    document.querySelectorAll<HTMLElement>('.grid li').forEach((li) => { li.hidden = kind !== 'all' && li.dataset.kind !== kind; });
  }));
</script>

<style>
  .page-title { font-size: 2rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 0.75rem; }
  .intro { margin-bottom: 1.5rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
  .chips button {
    font: inherit; font-size: 0.9rem; padding: 0.35rem 0.9rem; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--rule); background: var(--surface); color: var(--ink);
  }
  .chips button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--bg, #fff); }
  .grid { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; }
  .grid li[hidden] { display: none; }
  .grid a { position: relative; display: block; aspect-ratio: 1; overflow: hidden; background: var(--surface); border-radius: 4px; }
  .grid img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.25s ease; }
  .grid a:hover img { transform: scale(1.04); }
  .multi { position: absolute; top: 0.45rem; right: 0.45rem; width: 1.15rem; height: 1.15rem; fill: #fff; stroke: #fff; stroke-width: 2; filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.6)); }
  .multi path { fill: none; }
  .place {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 1.2rem 0.6rem 0.45rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.6)); color: #fff; font-size: 0.8rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; opacity: 0; transition: opacity 0.2s ease;
  }
  .grid a:hover .place, .grid a:focus-visible .place { opacity: 1; }
  .empty { color: var(--muted); }
</style>

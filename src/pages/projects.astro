---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// One short card per project; the full description lives on /projects/<id>
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Projects" description="Personal software projects by Mehmet Faruk Gül: backend services, developer tools and apps.">
  <h1 class="page-title">Projects</h1>
  <p class="lede intro">Things I build outside work, from backend services to small tools that solve my own problems.</p>
  <ul class="cards">
    {projects.map(({ id, data }) => (
      <li>
        <a class="card" href={`/projects/${id}`}>
          {data.icon
            ? <img class="icon" src={data.icon} alt="" width="52" height="52" loading="lazy" decoding="async" />
            : <span class="icon initial" aria-hidden="true">{data.title.charAt(0)}</span>}
          <span class="body">
            <span class="head">
              <span class="title">{data.title}</span>
              {data.demo && <span class="chip">App</span>}
            </span>
            <span class="sub">{data.subtitle}</span>
            <span class="foot">
              <span class={`status status-${data.status.toLowerCase()}`}>{data.status}</span>
              <span class="tags">{data.tags.slice(0, 3).join(' · ')}</span>
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .page-title { font-size: 2rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 0.75rem; }
  .intro { margin-bottom: 2rem; }

  .cards { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0.9rem; }
  .card {
    display: flex; gap: 0.9rem; height: 100%;
    padding: 1rem 1.1rem;
    background: var(--surface); border: 1px solid var(--rule); border-radius: 18px;
    color: var(--ink); text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .card:hover, .card:focus-visible { transform: translateY(-2px); border-color: var(--accent); box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08); }
  .icon { width: 52px; height: 52px; border-radius: 13px; flex: none; }
  .initial { display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); font-weight: 800; font-size: 1.4rem; }
  .body { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; flex: 1; }
  .head { display: flex; align-items: center; gap: 0.5rem; }
  .title { font-weight: 700; line-height: 1.3; }
  .chip { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.04em; color: var(--accent); background: var(--accent-soft); border-radius: 999px; padding: 0.1rem 0.5rem; }
  .sub { color: var(--ink-soft); font-size: 0.92rem; line-height: 1.4; }
  .foot { display: flex; align-items: center; gap: 0.6rem; margin-top: auto; padding-top: 0.4rem; font-size: 0.8rem; min-width: 0; }
  .foot .status { font-size: 0.8rem; }
  .tags { color: var(--muted); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .foot .status { flex: none; }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { goatcounterUrl } from '../data/analytics';

// Private stats page: not linked anywhere, not indexed and not counted itself.
// Data comes from the GoatCounter API with a read-only key kept in this browser only.
const ranges = [
  { days: 7, label: '7 gün' },
  { days: 30, label: '30 gün' },
  { days: 90, label: '90 gün' },
  { days: 365, label: '1 yıl' },
];

const lists = [
  { id: 'pages', title: 'Sayfalar' },
  { id: 'refs', title: 'Nereden geldiler' },
  { id: 'locations', title: 'Ülkeler' },
  { id: 'browsers', title: 'Tarayıcılar' },
  { id: 'systems', title: 'İşletim sistemleri' },
  { id: 'sizes', title: 'Ekran' },
];
---
<BaseLayout title="Admin" lang="tr" noindex track={false}>
  <h1 class="page-title">Ziyaretçiler</h1>

  <section id="setup" class="setup" hidden>
    <p class="lede">
      İstatistikler <a href={goatcounterUrl} rel="noopener">GoatCounter</a> üzerinden geliyor.
      Bu sayfanın veriyi okuyabilmesi için bir kez API anahtarı girmen yeterli; anahtar sadece bu tarayıcıda saklanır.
    </p>
    <ol class="steps">
      <li><a href={goatcounterUrl} rel="noopener">{goatcounterUrl.replace('https://', '')}</a> hesabına giriş yap.</li>
      <li><strong>User → API</strong> sayfasında yeni anahtar oluştur, sadece <strong>Read statistics</strong> iznini işaretle.</li>
      <li>Anahtarı aşağıya yapıştır.</li>
    </ol>
    <form id="token-form" class="token-form">
      <label for="token">API anahtarı</label>
      <div class="row">
        <input id="token" name="token" type="password" autocomplete="off" spellcheck="false" required />
        <button type="submit" class="button">Kaydet</button>
      </div>
      <p id="setup-error" class="error" role="alert" hidden></p>
    </form>
  </section>

  <section id="dash" hidden>
    <div class="toolbar">
      <div class="ranges" role="group" aria-label="Zaman aralığı">
        {ranges.map((r) => (
          <button type="button" data-days={r.days} aria-pressed={r.days === 30 ? 'true' : 'false'}>{r.label}</button>
        ))}
      </div>
      <button type="button" id="refresh" class="ghost">Yenile</button>
    </div>
    <p id="status" class="status-line" aria-live="polite"></p>

    <div class="kpis">
      <div class="kpi"><span class="kpi-label">Ziyaretçi</span><span id="kpi-total" class="kpi-value">–</span></div>
      <div class="kpi"><span class="kpi-label">Bugün</span><span id="kpi-today" class="kpi-value">–</span></div>
      <div class="kpi"><span class="kpi-label">Günlük ortalama</span><span id="kpi-avg" class="kpi-value">–</span></div>
      <div class="kpi"><span class="kpi-label">En yoğun gün</span><span id="kpi-best" class="kpi-value">–</span><span id="kpi-best-day" class="kpi-sub"></span></div>
    </div>

    <figure class="chart-card">
      <figcaption id="chart-title">Günlük ziyaretçi</figcaption>
      <div class="chart-wrap">
        <div id="chart" class="chart" role="img" aria-label="Günlük ziyaretçi grafiği"></div>
        <div id="tip" class="tip" hidden></div>
      </div>
      <div class="axis"><span id="axis-start"></span><span id="axis-end"></span></div>
    </figure>

    <div class="lists">
      {lists.map((l) => (
        <section class="list-card" aria-labelledby={`h-${l.id}`}>
          <h2 id={`h-${l.id}`}>{l.title}</h2>
          <ol id={`list-${l.id}`} class="bars"><li class="empty">Yükleniyor…</li></ol>
        </section>
      ))}
    </div>

    <div class="settings">
      <label class="check">
        <input type="checkbox" id="skip-me" />
        Bu tarayıcıdaki kendi ziyaretlerimi sayma
      </label>
      <a href={goatcounterUrl} rel="noopener">GoatCounter panelini aç</a>
      <button type="button" id="forget" class="ghost small">Anahtarı bu tarayıcıdan sil</button>
    </div>
  </section>

  <noscript><p class="lede">Bu sayfa JavaScript gerektirir.</p></noscript>
</BaseLayout>

<script define:vars={{ api: `${goatcounterUrl}/api/v0` }}>
  const TOKEN_KEY = 'gc-token';
  const RANGE_KEY = 'gc-range';
  const $ = (id) => document.getElementById(id);

  const store = {
    get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
    set(k, v) { try { localStorage.setItem(k, v); } catch (e) {} },
    del(k) { try { localStorage.removeItem(k); } catch (e) {} },
  };

  const nf = new Intl.NumberFormat('tr-TR');
  const dayFmt = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'short' });
  const longFmt = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric', weekday: 'short' });

  const sizeNames = {
    phone: 'Telefon', largephone: 'Büyük telefon', tablet: 'Tablet',
    desktop: 'Masaüstü', desktophd: 'Masaüstü (HD)', unknown: 'Bilinmiyor',
  };

  let days = Number(store.get(RANGE_KEY)) || 30;
  let loading = 0;   // id of the current load, so a stale one stops writing

  class AuthError extends Error {}

  // GoatCounter wants RFC 3339 without milliseconds
  const iso = (d) => d.toISOString().replace(/\.\d{3}Z$/, 'Z');

  async function call(path, params, token) {
    const url = new URL(api + path);
    Object.entries(params).forEach(([k, v]) => url.searchParams.set(k, String(v)));
    const res = await fetch(url, {
      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
    });
    if (res.status === 401 || res.status === 403) throw new AuthError('Anahtar geçersiz ya da yetkisi yok.');
    if (!res.ok) throw new Error(`GoatCounter ${res.status} döndürdü.`);
    return res.json();
  }

  function showSetup(message) {
    $('dash').hidden = true;
    $('setup').hidden = false;
    const err = $('setup-error');
    err.hidden = !message;
    err.textContent = message || '';
    $('token').focus();
  }

  function showDash() {
    $('setup').hidden = true;
    $('dash').hidden = false;
    document.querySelectorAll('.ranges button').forEach((b) =>
      b.setAttribute('aria-pressed', String(Number(b.dataset.days) === days)));
  }

  // ---------- Rendering ----------

  function renderList(id, rows, label) {
    const ol = $(`list-${id}`);
    ol.replaceChildren();
    if (!rows.length) {
      const li = document.createElement('li');
      li.className = 'empty';
      li.textContent = 'Henüz veri yok';
      ol.append(li);
      return;
    }
    const max = Math.max(...rows.map((r) => r.count), 1);
    rows.forEach((r) => {
      const li = document.createElement('li');
      li.style.setProperty('--w', `${(r.count / max) * 100}%`);
      const name = document.createElement('span');
      name.className = 'bar-name';
      name.textContent = label(r);
      name.title = name.textContent;
      const count = document.createElement('span');
      count.className = 'bar-count';
      count.textContent = nf.format(r.count);
      li.append(name, count);
      ol.append(li);
    });
  }

  function renderChart(series) {
    // Long ranges are summed per week so the bars stay readable
    const weekly = series.length > 90;
    let points = series;
    if (weekly) {
      points = [];
      for (let i = 0; i < series.length; i += 7) {
        const chunk = series.slice(i, i + 7);
        points.push({ day: chunk[0].day, end: chunk[chunk.length - 1].day, count: chunk.reduce((s, p) => s + p.count, 0) });
      }
    }
    $('chart-title').textContent = weekly ? 'Haftalık ziyaretçi' : 'Günlük ziyaretçi';

    const chart = $('chart');
    chart.replaceChildren();
    chart.classList.toggle('dense', points.length > 45);
    const max = Math.max(...points.map((p) => p.count), 1);
    points.forEach((p) => {
      const col = document.createElement('div');
      col.className = 'col';
      const bar = document.createElement('div');
      bar.className = 'bar';
      bar.style.height = p.count ? `${Math.max((p.count / max) * 100, 1.5)}%` : '0';
      col.append(bar);
      const when = p.end
        ? `${dayFmt.format(p.day)} – ${dayFmt.format(p.end)}`
        : longFmt.format(p.day);
      col.dataset.tip = `${when}\n${nf.format(p.count)} ziyaretçi`;
      chart.append(col);
    });
    $('axis-start').textContent = points.length ? dayFmt.format(points[0].day) : '';
    $('axis-end').textContent = points.length ? dayFmt.format(points[points.length - 1].end || points[points.length - 1].day) : '';
    chart.setAttribute('aria-label', `${weekly ? 'Haftalık' : 'Günlük'} ziyaretçi grafiği, en yüksek ${nf.format(max)}`);
  }

  // Tooltip follows the hovered column
  const chartEl = $('chart');
  const tip = $('tip');
  chartEl.addEventListener('pointermove', (e) => {
    const col = e.target.closest('.col');
    chartEl.querySelectorAll('.col.on').forEach((c) => c !== col && c.classList.remove('on'));
    if (!col) { tip.hidden = true; return; }
    col.classList.add('on');
    tip.textContent = col.dataset.tip;
    tip.hidden = false;
    const wrap = chartEl.getBoundingClientRect();
    const c = col.getBoundingClientRect();
    const x = c.left - wrap.left + c.width / 2;
    tip.style.left = `${Math.min(Math.max(x, tip.offsetWidth / 2), wrap.width - tip.offsetWidth / 2)}px`;
  });
  chartEl.addEventListener('pointerleave', () => {
    tip.hidden = true;
    chartEl.querySelectorAll('.col.on').forEach((c) => c.classList.remove('on'));
  });

  // ---------- Loading ----------

  async function load() {
    const token = store.get(TOKEN_KEY);
    if (!token) return showSetup();
    showDash();

    const id = ++loading;
    const end = new Date();
    const start = new Date(end);
    start.setHours(0, 0, 0, 0);
    start.setDate(start.getDate() - (days - 1));
    const range = { start: iso(start), end: iso(end) };
    $('status').textContent = 'Yükleniyor…';

    try {
      const total = await call('/stats/total', range, token);
      if (id !== loading) return;

      const series = (total.stats || []).map((s) => ({ day: new Date(`${s.day}T00:00:00`), count: s.daily || 0 }));
      const sum = total.total ?? series.reduce((s, p) => s + p.count, 0);
      const best = series.reduce((b, p) => (p.count > (b?.count ?? -1) ? p : b), null);
      $('kpi-total').textContent = nf.format(sum);
      $('kpi-today').textContent = nf.format(series.length ? series[series.length - 1].count : 0);
      $('kpi-avg').textContent = nf.format(Math.round(sum / Math.max(series.length, 1)));
      $('kpi-best').textContent = best && best.count ? nf.format(best.count) : '–';
      $('kpi-best-day').textContent = best && best.count ? longFmt.format(best.day) : '';
      renderChart(series);

      // One request at a time: the API is rate limited
      const lists = [
        ['pages', '/stats/hits', 'hits', (r) => r.title ? `${r.path} · ${r.title}` : r.path],
        ['refs', '/stats/toprefs', 'stats', (r) => r.name || 'Doğrudan / bilinmiyor'],
        ['locations', '/stats/locations', 'stats', (r) => r.name || 'Bilinmiyor'],
        ['browsers', '/stats/browsers', 'stats', (r) => r.name || 'Bilinmiyor'],
        ['systems', '/stats/systems', 'stats', (r) => r.name || 'Bilinmiyor'],
        ['sizes', '/stats/sizes', 'stats', (r) => sizeNames[r.id] || sizeNames[r.name] || r.name || 'Bilinmiyor'],
      ];
      for (const [listId, path, key, label] of lists) {
        const data = await call(path, { ...range, limit: 10 }, token);
        if (id !== loading) return;
        renderList(listId, data[key] || [], label);
      }
      $('status').textContent = `Son güncelleme: ${new Date().toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })}`;
    } catch (err) {
      if (id !== loading) return;
      if (err instanceof AuthError) {
        store.del(TOKEN_KEY);
        return showSetup(err.message);
      }
      $('status').textContent = err instanceof TypeError
        ? 'GoatCounter\'a ulaşılamadı. İnternet bağlantını ya da reklam engelleyiciyi kontrol et.'
        : err.message;
    }
  }

  // ---------- Controls ----------

  $('token-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const value = $('token').value.trim();
    if (!value) return;
    store.set(TOKEN_KEY, value);
    $('token').value = '';
    load();
  });

  document.querySelectorAll('.ranges button').forEach((b) => b.addEventListener('click', () => {
    days = Number(b.dataset.days);
    store.set(RANGE_KEY, String(days));
    load();
  }));

  $('refresh').addEventListener('click', load);

  $('forget').addEventListener('click', () => {
    store.del(TOKEN_KEY);
    showSetup();
  });

  // count.js skips counting when this flag is set (same as visiting /#toggle-goatcounter)
  const skip = $('skip-me');
  skip.checked = store.get('skipgc') === 't';
  skip.addEventListener('change', () => (skip.checked ? store.set('skipgc', 't') : store.del('skipgc')));

  load();
</script>

<style>
  .page-title { font-size: 2rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 1.25rem; }

  /* ---------- Setup ---------- */
  .steps { margin: 1.25rem 0 1.5rem 1.25rem; display: grid; gap: 0.35rem; color: var(--ink-soft); }
  .token-form label { display: block; font-weight: 700; margin-bottom: 0.4rem; }
  .row { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .row input {
    flex: 1 1 16rem; min-width: 0;
    font: inherit; font-family: var(--font-mono); font-size: 0.9rem;
    color: var(--ink); background: var(--surface);
    border: 1px solid var(--rule); border-radius: 8px;
    padding: 0.55rem 0.75rem;
  }
  .row input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .row .button { border: 0; font: inherit; font-weight: 700; cursor: pointer; }
  .error { margin-top: 0.75rem; color: var(--accent); font-weight: 500; }

  /* ---------- Toolbar ---------- */
  .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .ranges { display: inline-flex; background: var(--surface); border: 1px solid var(--rule); border-radius: 10px; padding: 3px; }
  .ranges button {
    font: inherit; font-size: 0.9rem;
    color: var(--ink-soft); background: none;
    border: 0; border-radius: 7px;
    padding: 0.3rem 0.8rem; cursor: pointer;
  }
  .ranges button:hover { color: var(--ink); }
  .ranges button[aria-pressed='true'] { background: var(--accent-soft); color: var(--accent); font-weight: 700; }
  .ghost {
    font: inherit; font-size: 0.9rem;
    color: var(--ink-soft); background: var(--surface);
    border: 1px solid var(--rule); border-radius: 8px;
    padding: 0.35rem 0.85rem; cursor: pointer;
  }
  .ghost:hover { color: var(--ink); border-color: var(--muted); }
  .ghost.small { font-size: 0.85rem; padding: 0.25rem 0.7rem; }
  .status-line { min-height: 1.5em; margin: 0.6rem 0 1.25rem; font-size: 0.85rem; color: var(--muted); }

  /* ---------- KPIs ---------- */
  .kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; margin-bottom: 1rem; }
  .kpi {
    display: grid; gap: 0.15rem; align-content: start;
    background: var(--surface); border: 1px solid var(--rule); border-radius: 12px;
    padding: 0.85rem 1rem;
  }
  .kpi-label { font-size: 0.8rem; color: var(--muted); }
  .kpi-sub { font-size: 0.8rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .kpi-value { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.01em; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* ---------- Chart ---------- */
  .chart-card, .list-card { background: var(--surface); border: 1px solid var(--rule); border-radius: 12px; padding: 1rem 1.1rem; }
  .chart-card figcaption, .list-card h2 { font-size: 0.95rem; font-weight: 700; color: var(--ink); margin-bottom: 0.75rem; }
  .chart-wrap { position: relative; }
  .chart {
    height: 11rem;
    display: flex; align-items: flex-end; gap: 2px;
    border-bottom: 1px solid var(--rule);
  }
  .chart.dense { gap: 1px; }
  .chart :global(.col) { flex: 1 1 0; height: 100%; display: flex; align-items: flex-end; min-width: 0; cursor: default; }
  .chart :global(.bar) { width: 100%; background: var(--accent); border-radius: 4px 4px 0 0; opacity: 0.85; transition: opacity 0.12s; }
  .chart.dense :global(.bar) { border-radius: 2px 2px 0 0; }
  .chart :global(.col.on .bar) { opacity: 1; }
  .chart:hover :global(.col:not(.on) .bar) { opacity: 0.45; }
  .tip {
    position: absolute; bottom: calc(100% - 0.5rem); transform: translateX(-50%);
    pointer-events: none; white-space: pre; text-align: center;
    font-size: 0.8rem; line-height: 1.4;
    color: var(--ink); background: var(--bg);
    border: 1px solid var(--rule); border-radius: 8px;
    padding: 0.35rem 0.6rem;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
  }
  .axis { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--muted); margin-top: 0.35rem; }

  /* ---------- Ranked lists ---------- */
  .lists { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; margin-top: 0.75rem; }
  .list-card { min-width: 0; }
  .bars { list-style: none; display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; }
  .bars :global(li) {
    position: relative; isolation: isolate;
    display: flex; justify-content: space-between; gap: 0.75rem;
    font-size: 0.875rem; padding: 0.2rem 0.5rem;
  }
  .bars :global(li)::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    width: var(--w, 0); border-radius: 4px;
    background: var(--accent-soft);
  }
  .bars :global(.bar-name) { color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .bars :global(.bar-count) { color: var(--ink); font-weight: 500; }
  .bars :global(.empty) { color: var(--muted); }

  /* ---------- Settings ---------- */
  .settings {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem;
    margin-top: 1.75rem; padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.9rem; color: var(--ink-soft);
  }
  .check { display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer; }
  .check input { accent-color: var(--accent); width: 1rem; height: 1rem; }

  @media (max-width: 640px) {
    .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lists { grid-template-columns: 1fr; }
    .chart { height: 9rem; }
  }
</style>

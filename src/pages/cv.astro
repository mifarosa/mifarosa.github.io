---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { profile, contact, experience, skills, certifications, education, leadership } from '../data/profile';

// Full CV. Printing it (or "Save as PDF") gives a one-column document without the sidebar.
const site = 'mifarosa.com';

// Side projects and apps, each with one link: the live app when there is one, else the code
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const shortUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---
<BaseLayout title="CV" description={`CV of ${profile.name}: ${profile.title}. Experience, skills and education.`}>
  <header class="cv-head">
    <h1 class="page-title">{profile.name}</h1>
    <p class="cv-role">{profile.title} · {profile.location}</p>
    <p class="cv-contact">
      <a href={`mailto:${contact.emails[0]}`}>{contact.emails[0]}</a>
      <a href={contact.linkedin} rel="noopener">{contact.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a>
      <a href={contact.github[0]} rel="noopener">{contact.github[0].replace(/^https?:\/\//, '')}</a>
      <a href="/" class="print-only">{site}</a>
    </p>
    <p class="lede">{profile.summary}</p>
    <p class="cv-actions no-print">
      <button type="button" class="button" id="print-cv" data-track="CV yazdır">Print / save as PDF</button>
      {profile.cvUrl && <a class="ghost-button" href={profile.cvUrl} download data-track="CV indirme">Download PDF</a>}
    </p>
  </header>

  <!-- EXPERIENCE -->
  <section id="experience" class="section">
    <SectionTitle id="experience" title="Experience" />
    <ol class="timeline">
      {experience.map((job) => (
        <li class="job">
          <p class="job-period">{job.period}</p>
          <div>
            <h3 class="job-title">{job.role}, <span>{job.company}</span></h3>
            <p class="meta">{job.type}</p>
            {job.points.length > 1 ? (
              <ul class="job-points">{job.points.map((p) => <li>{p}</li>)}</ul>
            ) : (
              <p class="job-desc">{job.points[0]}</p>
            )}
            <p class="stack"><strong>Stack:</strong> {job.tags.join(', ')}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="section">
    <SectionTitle id="projects" title="Projects & apps" />
    <ul class="cv-projects">
      {projects.map(({ data }) => {
        const link = data.demo ?? data.repo;
        return (
          <li>
            <p class="job-title small">{data.title}, <span>{data.subtitle}</span></p>
            <p class="stack">
              {data.tags.join(', ')}
              {link && <> · <a href={link} rel="noopener">{shortUrl(link)}</a></>}
            </p>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- SKILLS -->
  <section id="skills" class="section">
    <SectionTitle id="skills" title="Skills" />
    <dl class="skills">
      {skills.map((s) => (
        <div>
          <dt>{s.group}</dt>
          <dd>{s.items.join(', ')}</dd>
        </div>
      ))}
      <div>
        <dt>Certifications</dt>
        <dd>{certifications.join(', ')}</dd>
      </div>
    </dl>
  </section>

  <!-- EDUCATION & LEADERSHIP -->
  <section id="education" class="section">
    <SectionTitle id="education" title="Education" />
    <ol class="timeline">
      {education.map((e) => (
        <li class="job">
          <p class="job-period">{e.period}</p>
          <div>
            <h3 class="job-title">{e.degree}, <span>{e.school}</span></h3>
            <p class="job-desc">{e.detail}</p>
          </div>
        </li>
      ))}
    </ol>

    <h3 class="sub-title">Student teams and volunteering</h3>
    <ol class="timeline compact">
      {leadership.map((l) => (
        <li class="job">
          <p class="job-period">{l.period}</p>
          <div>
            <p class="job-title small">{l.role}, <span>{l.org}</span></p>
            <p class="job-desc">{l.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<script>
  document.getElementById('print-cv')?.addEventListener('click', () => window.print());
</script>

<style>
  .page-title { font-size: 2rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.2; }
  .cv-role { color: var(--ink-soft); margin: 0.35rem 0 0.5rem; }
  .cv-contact { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; font-size: 0.95rem; margin-bottom: 1.5rem; }
  .cv-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .cv-actions .button { border: 0; font: inherit; font-weight: 500; cursor: pointer; }
  .ghost-button {
    display: inline-block; padding: 0.5rem 1rem; border-radius: 6px;
    border: 1px solid var(--rule); background: var(--surface);
    color: var(--ink); text-decoration: none; font-weight: 500;
  }
  .ghost-button:hover { border-color: var(--accent); color: var(--accent); }
  .print-only { display: none; }

  .cv-projects { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 2rem; }
  .cv-projects li { min-width: 0; }
  .cv-projects .stack { margin-top: 0.15rem; overflow-wrap: anywhere; }
  .cv-head + .section { padding-top: 3rem; }

  /* ---------- Timeline (experience, education) ---------- */
  .timeline { list-style: none; }
  .job {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1.5rem;
    padding: 1.4rem 0;
  }
  .job + .job { border-top: 1px solid var(--rule); }
  .job:first-child { padding-top: 0; }
  .job-period { color: var(--muted); font-size: 0.9rem; padding-top: 0.15rem; white-space: nowrap; }
  .job-title { font-size: 1.05rem; font-weight: 700; line-height: 1.4; }
  .job-title span { font-weight: 400; color: var(--ink-soft); }
  .job-title.small { font-size: 1rem; }
  .job-points, .job-desc { color: var(--ink-soft); margin: 0.5rem 0 0.6rem; }
  .job-points { padding-left: 1.1rem; list-style: disc; }
  .job-points li + li { margin-top: 0.3rem; }
  .job-points li::marker { color: var(--accent); }
  .compact .job { padding: 1rem 0; }

  .sub-title { font-size: 1rem; font-weight: 700; margin: 2.25rem 0 0.75rem; color: var(--ink-soft); }

  /* ---------- Skills ---------- */
  .skills { display: grid; gap: 0.9rem; }
  .skills div { display: grid; grid-template-columns: 12.5rem 1fr; gap: 1rem; }
  .skills dt { font-weight: 700; }
  .skills dd { color: var(--ink-soft); }

  @media (max-width: 640px) {
    .cv-projects { grid-template-columns: 1fr; }
    .job, .skills div { grid-template-columns: 1fr; gap: 0.15rem; }
    .skills { gap: 1.1rem; }
  }

  @media print {
    .no-print { display: none !important; }
    .page-title { font-size: 1.6rem; }
    .lede { font-size: 1rem; }
    .cv-contact { margin-bottom: 0.75rem; }
    .section-title { margin-bottom: 0.6rem; padding-bottom: 0.3rem; font-size: 1.15rem; }
    .job-points li + li { margin-top: 0.1rem; }
    .job-points, .job-desc { margin: 0.25rem 0 0.3rem; }
    .cv-projects { gap: 0.5rem 1.5rem; }
    .cv-projects li { break-inside: avoid; }
    .cv-head + .section { padding-top: 1.25rem; }
    .job { grid-template-columns: 10rem 1fr; gap: 1rem; }
    .compact .job { padding: 0.35rem 0; }
    .sub-title { margin: 1rem 0 0.3rem; }
    .skills { gap: 0.3rem; }
    .skills div { grid-template-columns: 11rem 1fr; }
    .print-only { display: inline; }
    .cv-contact a { color: inherit; text-decoration: none; }
    .section { padding-top: 1rem; }
    .job { break-inside: avoid; padding: 0.5rem 0; }
  }
</style>

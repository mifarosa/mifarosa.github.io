---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, contact, experience, skills } from '../data/profile';

// Home page as a bento grid: one tile per thing worth a click.
// The full CV lives on /cv, every project on /projects.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const apps = projects.filter((p) => p.data.demo);
const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
const game = games[0];
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const post = posts[0];

const currentJob = experience[0];
const learning = skills.find((s) => s.group === 'Currently learning')?.items ?? [];

const postDate = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<BaseLayout>
  <div class="bento">
    <section class="tile intro">
      <p class="eyebrow">Hi, I'm Faruk 👋</p>
      <p class="headline">{profile.headline}</p>
      <p class="intro-links">
        <a class="button" href="/cv" data-track="CV sayfası">View my CV</a>
        <a class="ghost" href="/projects">All projects</a>
      </p>
    </section>

    <a class="tile work" href="/cv">
      <span class="label">Working</span>
      <strong>{currentJob.role}</strong>
      <span class="big">{currentJob.company}</span>
      {learning.length > 0 && <span class="small">Learning {learning.join(', ')}</span>}
    </a>

    <a class="tile soon" href="/projects">
      <span class="emoji" aria-hidden="true">📱</span>
      <strong>App Store &amp; Google Play</strong>
      <span class="small">Native versions are on the way</span>
    </a>

    {contact.coffee && (
      <a class="tile coffee" href={contact.coffee} rel="noopener" data-track="Kahve">
        <span class="emoji" aria-hidden="true">☕</span>
        <strong>Buy me a coffee</strong>
        <span class="small">Keeps the apps free</span>
      </a>
    )}

    {apps.map(({ data }) => (
      <a class="tile app" href={data.demo} rel="noopener" data-track={`Uygulama: ${data.title}`}>
        {data.icon
          ? <img src={data.icon} alt="" width="56" height="56" decoding="async" />
          : <span class="app-initial" aria-hidden="true">{data.title.charAt(0)}</span>}
        <strong>{data.title}</strong>
        <span class="small">{data.subtitle}</span>
      </a>
    ))}

    {post && (
      <a class="tile post" href={`/blog/${post.id}`}>
        <span class="label">Latest post · {postDate(post.data.date)}</span>
        <strong lang={post.data.lang}>{post.data.title}</strong>
        <span class="small" lang={post.data.lang}>{post.data.description}</span>
      </a>
    )}

    {game && (
      <a class="tile game" href={game.data.play} rel="noopener" data-track={`Oyun: ${game.data.title}`}>
        {game.data.cover && <img src={game.data.cover} alt="" decoding="async" />}
        <span class="game-label"><strong>{game.data.title}</strong> · {game.data.subtitle}</span>
      </a>
    )}

    <a class="tile social github" href={contact.github[0]} rel="noopener">
      <strong>GitHub</strong><span class="small">@{contact.github[0].split('/').pop()}</span>
    </a>
    <a class="tile social linkedin" href={contact.linkedin} rel="noopener">
      <strong>LinkedIn</strong><span class="small">Let's connect</span>
    </a>
    <a class="tile social newsletter" href={contact.newsletter} rel="noopener">
      <strong>Patch Incoming</strong><span class="small">Newsletter</span>
    </a>
    <a class="tile social mail" href={`mailto:${contact.emails[0]}`}>
      <strong>Email</strong><span class="small">Say hello</span>
    </a>
  </div>
</BaseLayout>

<style>
  :global(main:has(.bento)) { max-width: 54rem; }
  /* Contact links and coffee are tiles here, so the sidebar copies are hidden on this page */
  :global(.shell:has(.bento) aside .contact), :global(.shell:has(.bento) aside .coffee) { display: none; }

  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(9.5rem, auto);
    gap: 0.9rem;
  }
  .tile {
    display: flex; flex-direction: column; gap: 0.3rem;
    padding: 1.1rem 1.2rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 22px;
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  a.tile:hover { transform: translateY(-2px); border-color: var(--accent); box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08); }
  .tile strong { font-weight: 700; line-height: 1.25; }
  .small { color: var(--muted); font-size: 0.85rem; line-height: 1.4; }
  .label { color: var(--muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .emoji { font-size: 1.8rem; line-height: 1; margin-bottom: auto; }

  .intro { grid-column: span 2; grid-row: span 2; justify-content: space-between; background: var(--accent-soft); border-color: transparent; }
  .eyebrow { color: var(--accent); font-weight: 700; }
  .headline { font-size: 1.45rem; font-weight: 800; line-height: 1.25; letter-spacing: -0.01em; text-wrap: balance; }
  .intro-links { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .ghost {
    display: inline-block; padding: 0.5rem 1rem; border-radius: 6px;
    border: 1px solid var(--rule); background: var(--surface); color: var(--ink); text-decoration: none; font-weight: 500;
  }

  .work { grid-column: span 2; }
  .work .big { font-size: 2rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; margin-bottom: auto; }

  .coffee { background: #ffdd00; border-color: #ffdd00; color: #16181d; }
  .coffee .small { color: #4a4300; }

  .app img, .app-initial { width: 56px; height: 56px; border-radius: 14px; margin-bottom: 0.6rem; flex: none; }
  .app-initial { display: grid; place-items: center; background: var(--accent); color: #fff; font-weight: 800; font-size: 1.5rem; }

  .post { grid-column: span 2; }
  .post strong { font-size: 1.15rem; margin-top: auto; }
  .post .small { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .game { grid-column: span 2; padding: 0; position: relative; }
  .game img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .game-label {
    position: absolute; left: 0.8rem; bottom: 0.8rem; padding: 0.35rem 0.75rem; border-radius: 999px;
    background: rgba(255, 255, 255, 0.92); color: #16181d; font-size: 0.85rem;
  }

  .social { justify-content: flex-end; }
  .social strong { font-size: 1.05rem; }
  .github { background: #16181d; border-color: #16181d; color: #fff; }
  .github .small { color: #b8bec9; }
  .linkedin { background: #0a66c2; border-color: #0a66c2; color: #fff; }
  .linkedin .small { color: #cfe2f6; }
  :global([data-theme='dark']) .github { background: #2d333b; border-color: #2d333b; }

  @media (max-width: 640px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: minmax(8.5rem, auto); gap: 0.7rem; }
    .intro, .work, .post, .game { grid-column: span 2; }
    .intro { grid-row: auto; gap: 1rem; }
    .game { min-height: 11rem; }
  }
</style>

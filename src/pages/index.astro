---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProjectItem from '../components/ProjectItem.astro';
import { profile, experience, skills, certifications, education, leadership } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);

// "Right now" facts, derived from the data so they stay in sync
const currentJob = experience[0];
const learning = skills.find((s) => s.group === 'Currently learning')?.items ?? [];
const building = projects.filter((p) => p.data.status === 'Active');
---
<BaseLayout>
  <!-- ABOUT -->
  <section id="about" class="section intro">
    <p class="headline">{profile.headline}</p>
    <p class="lede">{profile.summary}</p>

    <dl class="now">
      <div>
        <dt>Working</dt>
        <dd>{currentJob.role} at {currentJob.company}</dd>
      </div>
      {building.length > 0 && (
        <div>
          <dt>Building</dt>
          <dd>
            {building.map((p, i) => (
              <>{i > 0 && ', '}<a href={p.data.repo ?? '/projects'} rel="noopener">{p.data.title}</a></>
            ))}
          </dd>
        </div>
      )}
      {learning.length > 0 && (
        <div>
          <dt>Learning</dt>
          <dd>{learning.join(', ')}</dd>
        </div>
      )}
    </dl>
  </section>

  <!-- EXPERIENCE -->
  <section id="experience" class="section">
    <SectionTitle id="experience" title="Experience" />
    <ol class="timeline">
      {experience.map((job) => (
        <li class="job">
          <p class="job-period">{job.period}</p>
          <div>
            <h3 class="job-title">{job.role}, <span>{job.company}</span></h3>
            <p class="meta">{job.type}</p>
            {job.points.length > 1 ? (
              <ul class="job-points">{job.points.map((p) => <li>{p}</li>)}</ul>
            ) : (
              <p class="job-desc">{job.points[0]}</p>
            )}
            <p class="stack"><strong>Stack:</strong> {job.tags.join(', ')}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="section">
    <SectionTitle id="projects" title="Projects" />
    {featured.map((p) => <ProjectItem project={p} />)}
    {projects.length > featured.length && (
      <p class="more"><a href="/projects">See all {projects.length} projects</a></p>
    )}
  </section>

  <!-- SKILLS -->
  <section id="skills" class="section">
    <SectionTitle id="skills" title="Skills" />
    <dl class="skills">
      {skills.map((s) => (
        <div>
          <dt>{s.group}</dt>
          <dd>{s.items.join(', ')}</dd>
        </div>
      ))}
      <div>
        <dt>Certifications</dt>
        <dd>{certifications.join(', ')}</dd>
      </div>
    </dl>
  </section>

  <!-- EDUCATION & LEADERSHIP -->
  <section id="education" class="section">
    <SectionTitle id="education" title="Education" />
    <ol class="timeline">
      {education.map((e) => (
        <li class="job">
          <p class="job-period">{e.period}</p>
          <div>
            <h3 class="job-title">{e.degree}, <span>{e.school}</span></h3>
            <p class="job-desc">{e.detail}</p>
          </div>
        </li>
      ))}
    </ol>

    <h3 class="sub-title">Student teams and volunteering</h3>
    <ol class="timeline compact">
      {leadership.map((l) => (
        <li class="job">
          <p class="job-period">{l.period}</p>
          <div>
            <p class="job-title small">{l.role}, <span>{l.org}</span></p>
            <p class="job-desc">{l.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  /* ---------- Intro ---------- */
  .intro { padding-top: 1rem; }
  .headline {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 22em;
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }
  .lede { margin-bottom: 2rem; }

  .now {
    display: grid;
    gap: 0.5rem;
    padding: 1.1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
  }
  .now div, .skills div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; }
  .now dt { color: var(--muted); }
  .now dd { color: var(--ink); }

  /* ---------- Timeline (experience, education) ---------- */
  .timeline { list-style: none; }
  .job {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1.5rem;
    padding: 1.4rem 0;
  }
  .job + .job { border-top: 1px solid var(--rule); }
  .job:first-child { padding-top: 0; }
  .job-period { color: var(--muted); font-size: 0.9rem; padding-top: 0.15rem; white-space: nowrap; }
  .job-title { font-size: 1.05rem; font-weight: 700; line-height: 1.4; }
  .job-title span { font-weight: 400; color: var(--ink-soft); }
  .job-title.small { font-size: 1rem; }
  .job-points, .job-desc { color: var(--ink-soft); margin: 0.5rem 0 0.6rem; }
  .job-points { padding-left: 1.1rem; list-style: disc; }
  .job-points li + li { margin-top: 0.3rem; }
  .job-points li::marker { color: var(--accent); }
  .compact .job { padding: 1rem 0; }

  .sub-title { font-size: 1rem; font-weight: 700; margin: 2.25rem 0 0.75rem; color: var(--ink-soft); }

  /* ---------- Skills ---------- */
  .skills { display: grid; gap: 0.9rem; }
  .skills div { grid-template-columns: 12.5rem 1fr; }
  .skills dt { font-weight: 700; }
  .skills dd { color: var(--ink-soft); }

  .more { margin-top: 1.75rem; }

  @media (max-width: 640px) {
    .job, .skills div, .now div { grid-template-columns: 1fr; gap: 0.15rem; }
    .skills { gap: 1.1rem; }
  }
</style>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
  profile, contact, experience, skills, certifications, education, leadership,
} from '../data/profile';

const featured = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);

const [firstName, middleName, lastName] = profile.name.split(' ');
const stripProtocol = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---
<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-grid-lines" aria-hidden="true"></div>

    <div class="hero-left">
      <p class="hero-eyebrow">{profile.location}</p>
      <h1 class="hero-name">{firstName}<br /><span>{middleName}</span> {lastName}</h1>
      <p class="hero-title">{profile.title}</p>
      <p class="hero-about">{profile.summary}</p>
      <div class="hero-cta">
        <a href={contact.linkedin} class="btn btn-primary" target="_blank" rel="noopener">Get in touch</a>
        {profile.cvUrl && <a href={profile.cvUrl} class="btn btn-outline" download>Download CV</a>}
        <a href={contact.newsletter} class="btn btn-outline" target="_blank" rel="noopener">Patch Incoming newsletter</a>
      </div>
    </div>

    <div class="hero-right">
      <div class="hero-card">
        <p class="hero-card-label">Contact</p>

        <div class="contact-item">
          <div class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <ul>
            {contact.emails.map((e) => <li><a href={`mailto:${e}`}>{e}</a></li>)}
          </ul>
        </div>

        <div class="contact-item">
          <div class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </div>
          <a href={contact.linkedin} target="_blank" rel="noopener">{stripProtocol(contact.linkedin)}</a>
        </div>

        <div class="contact-item">
          <div class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22"/></svg>
          </div>
          <ul>
            {contact.github.map((g) => <li><a href={g} target="_blank" rel="noopener">{stripProtocol(g)}</a></li>)}
          </ul>
        </div>

        <div class="contact-item">
          <div class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
          </div>
          <a href={contact.blog} target="_blank" rel="noopener">{stripProtocol(contact.blog)}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section id="experience" class="section">
    <SectionHeader title="Experience" />
    <div class="exp-list">
      {experience.map((job) => (
        <article class="exp-item fade-up">
          <div class="exp-left">
            <div class="exp-period">{job.period}</div>
            <div class="exp-company">{job.company}</div>
            <span class="exp-type">{job.type}</span>
          </div>
          <div class="exp-right">
            <h3 class="exp-role">{job.role}</h3>
            {job.points.length > 1 ? (
              <ul class="exp-points">{job.points.map((p) => <li>{p}</li>)}</ul>
            ) : (
              <p class="exp-desc">{job.points[0]}</p>
            )}
            <div class="tags">{job.tags.map((t) => <span class="tag">{t}</span>)}</div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills" class="section section-alt">
    <SectionHeader title="Skills" />
    <div class="skills-grid">
      {skills.map((s) => (
        <div class="fade-up">
          <h3 class="group-title">{s.group}</h3>
          <div class="skill-chips">{s.items.map((i) => <span class="chip">{i}</span>)}</div>
        </div>
      ))}
      <div class="fade-up">
        <h3 class="group-title">Certifications</h3>
        <ul class="plain-list">{certifications.map((c) => <li>{c}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="section">
    <SectionHeader title="Projects" link={{ href: '/projects', label: 'All projects' }} />
    <div>
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <!-- EDUCATION & LEADERSHIP -->
  <section id="education" class="section section-alt">
    <SectionHeader title="Education & leadership" />
    <div class="edu-grid">
      {education.map((e) => (
        <div class="edu-card fade-up">
          <p class="edu-degree">{e.degree}</p>
          <h3 class="edu-school">{e.school}</h3>
          <p class="edu-period">{e.period}</p>
          <p class="edu-detail">{e.detail}</p>
        </div>
      ))}
    </div>

    <div class="lead-list fade-up">
      {leadership.map((l) => (
        <div class="lead-item">
          <div class="lead-period">{l.period}</div>
          <div>
            <div class="lead-role">{l.role}, <span>{l.org}</span></div>
            <p class="lead-detail">{l.detail}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 4rem;
    padding: calc(var(--nav-h) + 2rem) var(--pad-x) 4rem;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 60% 80% at 80% 50%, rgba(123, 140, 222, 0.07) 0%, transparent 70%),
      radial-gradient(ellipse 40% 50% at 20% 80%, rgba(200, 169, 110, 0.05) 0%, transparent 60%);
  }
  .hero-grid-lines {
    position: absolute; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 0%, transparent 80%);
  }
  .hero-left, .hero-right { position: relative; z-index: 1; }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    margin-bottom: 1.5rem;
    display: flex; align-items: center; gap: 1rem;
  }
  .hero-eyebrow::before { content: ''; width: 40px; height: 1px; background: var(--accent); }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(3rem, 5vw, 5.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }
  .hero-name span { color: var(--accent); }
  .hero-title { color: var(--muted); letter-spacing: 0.03em; margin-bottom: 2rem; }
  .hero-about { font-size: 0.98rem; color: var(--text-soft); max-width: 60ch; line-height: 1.8; margin-bottom: 2.5rem; }
  .hero-cta { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  .hero-card {
    background: var(--bg2);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 2.25rem;
    width: 340px;
  }
  .hero-card-label { font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent); margin-bottom: 1rem; }
  .contact-item {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
  .contact-item:last-child { border-bottom: none; }
  .contact-item ul { list-style: none; }
  .contact-icon {
    width: 32px; height: 32px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: var(--bg3); border: 1px solid var(--line); border-radius: 2px;
  }
  .contact-icon svg { width: 14px; height: 14px; stroke: var(--accent2); fill: none; stroke-width: 1.5; }
  .contact-item a { color: var(--text); text-decoration: none; }
  .contact-item a:hover { color: var(--accent); }

  /* ---------- Experience ---------- */
  .exp-item {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .exp-item:first-child { padding-top: 0; }
  .exp-period { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); margin-bottom: 0.5rem; }
  .exp-company { font-size: 0.9rem; color: var(--accent); font-weight: 500; }
  .exp-type {
    display: inline-block; margin-top: 0.5rem;
    font-family: var(--font-mono); font-size: 0.68rem;
    color: var(--accent2);
    border: 1px solid rgba(123, 140, 222, 0.3);
    padding: 0.15rem 0.5rem; border-radius: 2px;
  }
  .exp-role { font-size: 1.1rem; font-weight: 500; margin-bottom: 0.75rem; }
  .exp-desc, .exp-points { font-size: 0.92rem; color: var(--text-soft); max-width: 70ch; margin-bottom: 1rem; }
  .exp-points { padding-left: 1.1rem; }
  .exp-points li + li { margin-top: 0.3rem; }
  .exp-points li::marker { color: var(--accent); }

  /* ---------- Skills ---------- */
  .skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 3rem 4rem; }
  .skill-chips { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .chip {
    padding: 0.5rem 0.9rem;
    background: var(--bg3);
    border: 1px solid var(--line);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-soft);
  }
  .plain-list { list-style: none; font-size: 0.92rem; color: var(--text-soft); }

  /* ---------- Education & leadership ---------- */
  .edu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 3rem; }
  .edu-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-top: 2px solid var(--accent);
    border-radius: 4px;
    padding: 2rem;
  }
  .edu-degree { font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent); margin-bottom: 0.75rem; }
  .edu-school { font-family: var(--font-display); font-size: 1.4rem; font-weight: 400; margin-bottom: 0.35rem; }
  .edu-period { font-family: var(--font-mono); font-size: 0.8rem; color: var(--muted); margin-bottom: 1rem; }
  .edu-detail { font-size: 0.9rem; color: var(--text-soft); }

  .lead-item {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
  }
  .lead-period { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); padding-top: 0.2rem; }
  .lead-role { font-weight: 500; }
  .lead-role span { color: var(--accent2); font-weight: 400; }
  .lead-detail { font-size: 0.9rem; color: var(--text-soft); max-width: 70ch; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: auto; padding-top: calc(var(--nav-h) + 3rem); gap: 3rem; }
    .hero-card { width: 100%; }
    .exp-item, .lead-item { grid-template-columns: 1fr; gap: 0.5rem; }
    .edu-grid { grid-template-columns: 1fr; }
  }
</style>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { profile, contact, experience, skills } from '../data/profile';

// Home page: a short introduction that points to the CV, projects and writing.
// The full CV lives on /cv.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// "Right now" facts, derived from the data so they stay in sync
const currentJob = experience[0];
const learning = skills.find((s) => s.group === 'Currently learning')?.items ?? [];
const building = projects.filter((p) => p.data.status === 'Active');

const postDate = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<BaseLayout>
  <!-- ABOUT -->
  <section id="about" class="section intro">
    <p class="headline">{profile.headline}</p>
    <p class="lede">{profile.summary}</p>

    <dl class="now">
      <div>
        <dt>Working</dt>
        <dd>{currentJob.role} at {currentJob.company}</dd>
      </div>
      {building.length > 0 && (
        <div>
          <dt>Building</dt>
          <dd>
            {building.map((p, i) => (
              <>{i > 0 && ', '}<a href={p.data.demo ?? p.data.repo ?? '/projects'} rel="noopener">{p.data.title}</a></>
            ))}
            {' '}and <a href="/projects">a few other side projects</a>
          </dd>
        </div>
      )}
      {learning.length > 0 && (
        <div>
          <dt>Learning</dt>
          <dd>{learning.join(', ')}</dd>
        </div>
      )}
    </dl>

    <p class="cta">
      <a class="button" href="/cv" data-track="CV sayfası">View my CV</a>
      {profile.cvUrl && <a class="ghost-button" href={profile.cvUrl} download data-track="CV indirme">Download CV (PDF)</a>}
    </p>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="section">
    <SectionTitle id="projects" title="Selected projects" />
    <ul class="cards">
      {featured.map(({ data }) => (
        <li class="card">
          <div class="card-head">
            <h3 class="card-title">{data.title}</h3>
            <span class={`status status-${data.status.toLowerCase()}`}>{data.status}</span>
          </div>
          <p class="card-desc">{data.subtitle}</p>
          <p class="card-stack">{data.tags.slice(0, 4).join(' · ')}</p>
          <p class="card-links">
            {data.demo && <a href={data.demo} rel="noopener" data-track={`Uygulama: ${data.title}`}>Open app</a>}
            {data.repo && <a href={data.repo} rel="noopener" data-track={`Proje kodu: ${data.title}`}>Source</a>}
          </p>
        </li>
      ))}
    </ul>
    <p class="more"><a href="/projects">All {projects.length} projects →</a></p>
  </section>

  {posts.length > 0 && (
    <section id="writing" class="section">
      <SectionTitle id="writing" title="Latest writing" />
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <time datetime={p.data.date.toISOString()}>{postDate(p.data.date)}</time>
            <a class="post-title" href={`/blog/${p.id}`} lang={p.data.lang}>{p.data.title}</a>
            <p lang={p.data.lang}>{p.data.description}</p>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/blog">All posts →</a></p>
    </section>
  )}

  <!-- CONTACT -->
  <section id="contact" class="section">
    <SectionTitle id="contact" title="Get in touch" />
    <p class="lede">Questions about a project, a role or something I wrote? Email is the fastest way to reach me.</p>
    <p class="link-row contact-row">
      <a href={`mailto:${contact.emails[0]}`}>{contact.emails[0]}</a>
      <a href={contact.linkedin} rel="noopener">LinkedIn</a>
      <a href={contact.github[0]} rel="noopener">GitHub</a>
    </p>
  </section>
</BaseLayout>

<style>
  /* ---------- Intro ---------- */
  .headline {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 22em;
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }
  .lede { margin-bottom: 2rem; }

  .now {
    display: grid;
    gap: 0.5rem;
    padding: 1.1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
  }
  .now div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; }
  .now dt { color: var(--muted); }
  .now dd { color: var(--ink); }

  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .ghost-button {
    display: inline-block; padding: 0.5rem 1rem; border-radius: 6px;
    border: 1px solid var(--rule); background: var(--surface);
    color: var(--ink); text-decoration: none; font-weight: 500;
  }
  .ghost-button:hover { border-color: var(--accent); color: var(--accent); }

  /* ---------- Project cards ---------- */
  .cards { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: 1rem; }
  .card {
    display: flex; flex-direction: column; gap: 0.4rem;
    background: var(--surface); border: 1px solid var(--rule); border-radius: 10px;
    padding: 1rem 1.1rem;
  }
  .card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; }
  .card-title { font-size: 1.05rem; font-weight: 700; line-height: 1.3; }
  .card-desc { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.5; }
  .card-stack { color: var(--muted); font-size: 0.82rem; margin-top: auto; padding-top: 0.25rem; }
  .card-links { display: flex; gap: 1rem; font-size: 0.9rem; }

  /* ---------- Writing ---------- */
  .posts { list-style: none; display: grid; gap: 1.25rem; }
  .posts time { display: block; color: var(--muted); font-size: 0.85rem; }
  .post-title { font-weight: 700; color: var(--ink); text-decoration: none; }
  .post-title:hover { color: var(--accent); text-decoration: underline; }
  .posts p { color: var(--ink-soft); margin-top: 0.2rem; }

  .more { margin-top: 1.5rem; }
  .contact-row { margin-top: 1rem; }

  @media (max-width: 640px) {
    .now div { grid-template-columns: 1fr; gap: 0.15rem; }
  }
</style>

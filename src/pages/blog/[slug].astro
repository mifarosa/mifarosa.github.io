---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post">
    <header>
      <a class="back" href="/blog">Back to blog</a>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.date.toISOString()}>{date}</time>
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>

<style>
  .post { max-width: 72ch; margin: 0 auto; padding: calc(var(--nav-h) + 4rem) 1.5rem 5rem; }
  .back { font-family: var(--font-mono); font-size: 0.8rem; color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--accent); }
  h1 { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; margin: 1.5rem 0 0.75rem; }
  time { font-family: var(--font-mono); font-size: 0.8rem; color: var(--muted); }
  .prose { margin-top: 2.5rem; color: var(--text-soft); font-weight: 400; }
  .prose :global(h2) { font-family: var(--font-display); font-weight: 400; color: var(--text); font-size: 1.6rem; margin: 2.5rem 0 1rem; }
  .prose :global(h3) { color: var(--text); font-weight: 500; margin: 2rem 0 0.75rem; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin-bottom: 1.25rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.25rem; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.88em; background: var(--bg3); padding: 0.1rem 0.35rem; border-radius: 2px; }
  .prose :global(pre) { background: var(--bg2) !important; border: 1px solid var(--line); padding: 1.25rem; border-radius: 4px; overflow-x: auto; margin-bottom: 1.25rem; }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: 4px; }
</style>

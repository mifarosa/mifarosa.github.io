---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contact } from '../../data/profile';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<BaseLayout title="Blog" description="Writing by Mehmet Faruk Gül on software engineering and personal projects.">
  <header class="page-head">
    <h1>Blog</h1>
    {posts.length > 0 ? (
      <p>Notes on software engineering, tools and the projects I work on.</p>
    ) : (
      <p>
        Posts are moving here from my old blog. Until then you can read them at
        <a href={contact.blog} target="_blank" rel="noopener">mfgstudiosblog.com</a> or follow the
        <a href={contact.newsletter} target="_blank" rel="noopener">Patch Incoming newsletter</a>.
      </p>
    )}
  </header>

  {posts.length > 0 && (
    <section class="section posts">
      {posts.map((post) => (
        <a class="post" href={`/blog/${post.id}`}>
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          <div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </div>
        </a>
      ))}
    </section>
  )}
</BaseLayout>

<style>
  .page-head a { color: var(--accent); }
  .posts { border-top: none; padding-top: 1rem; }
  .post {
    display: grid; grid-template-columns: 160px 1fr; gap: 2rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .post time { font-family: var(--font-mono); font-size: 0.8rem; color: var(--muted); padding-top: 0.3rem; }
  .post h2 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 400; margin-bottom: 0.35rem; }
  .post p { color: var(--text-soft); font-size: 0.92rem; }
  .post:hover h2 { color: var(--accent); }
  @media (max-width: 900px) { .post { grid-template-columns: 1fr; gap: 0.5rem; } }
</style>

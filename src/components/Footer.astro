---
import { profile, contact } from '../data/profile';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer-name">{profile.name}, {profile.title}</div>
  <div class="footer-links">
    <a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    <a href={contact.github[0]} target="_blank" rel="noopener">GitHub</a>
    <a href={`mailto:${contact.emails[0]}`}>Email</a>
  </div>
  <div class="footer-copy">© {year} mifarosa.com</div>
</footer>

<style>
  .footer {
    padding: 3rem var(--pad-x);
    border-top: 1px solid var(--line);
    display: flex; justify-content: space-between; align-items: center; gap: 1.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .footer-name { color: var(--muted); }
  .footer-links { display: flex; gap: 1.5rem; }
  .footer-links a { color: var(--muted); text-decoration: none; }
  .footer-links a:hover { color: var(--accent); }
  .footer-copy { color: rgba(255, 255, 255, 0.25); }
  @media (max-width: 900px) {
    .footer { flex-direction: column; text-align: center; }
  }
</style>

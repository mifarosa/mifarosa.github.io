---
interface Props {
  title: string;
  link?: { href: string; label: string };
}
const { title, link } = Astro.props;
---
<div class="section-header fade-up">
  <h2 class="section-title">{title}</h2>
  <div class="section-line"></div>
  {link && <a class="section-link" href={link.href}>{link.label}</a>}
</div>

---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import AppTiles from '../components/AppTiles.astro';
import { profile, contact } from '../data/profile';
import ConsentBanner from '../components/ConsentBanner.astro';
import { goatcounterUrl, gaMeasurementId } from '../data/analytics';

interface Props {
  title?: string;
  description?: string;
  lang?: string;   // language of the page content, e.g. 'tr' for Turkish posts
  noindex?: boolean;  // keep the page out of search engines
  track?: boolean;    // count visits with GoatCounter (off for the admin page)
}

const {
  title,
  lang = 'en',
  noindex = false,
  track = true,
  description = 'Mehmet Faruk Gül, Software Engineer at Huawei. Backend development with Java and Python, personal projects and writing.',
} = Astro.props;

const fullTitle = title ? `${title} | ${profile.name}` : `${profile.name} | Software Engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// Site pages; the current one (or its section, e.g. a blog post) is highlighted
const nav = [
  { href: '/', label: 'Home' },
  { href: '/cv', label: 'CV' },
  { href: '/projects', label: 'Projects' },
  { href: '/games', label: 'Games' },
  { href: '/blog', label: 'Blog' },
].map((n) => ({ ...n, current: n.href === '/' ? path === '/' : path === n.href || path.startsWith(`${n.href}/`) }));

const year = new Date().getFullYear();

// Google Analytics runs only on the live site, on tracked pages, once an ID is configured
const useGa = import.meta.env.PROD && track && !!gaMeasurementId;

// Projects with a live app (a `demo` URL) show up in the Apps launcher
const apps = (await getCollection('projects'))
  .filter((p) => p.data.demo)
  .sort((a, b) => a.data.order - b.data.order);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14161b" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph: link previews on LinkedIn, WhatsApp, etc. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:wght@400;500&family=Atkinson+Hyperlegible+Next:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Apply the saved theme before first paint to avoid a flash -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>

    <!-- Visitor stats (GoatCounter: no cookies, no personal data). Only on the live site. -->
    {import.meta.env.PROD && track && (
      <script is:inline async data-goatcounter={`${goatcounterUrl}/count`} src="https://gc.zgo.at/count.js"></script>
    )}

    <!-- Google Analytics with Consent Mode: no analytics cookies until the visitor accepts,
         ads signals always off. The owner's "don't count my visits" flag turns it off too. -->
    {useGa && (
      <script is:inline define:vars={{ gaId: gaMeasurementId }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        let choice = null, skip = false;
        try { choice = localStorage.getItem('consent'); skip = localStorage.getItem('skipgc') === 't'; } catch (e) {}
        if (skip) window[`ga-disable-${gaId}`] = true;
        gtag('consent', 'default', {
          analytics_storage: choice === 'granted' ? 'granted' : 'denied',
          ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
        });
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    )}
    {useGa && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>}
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <div class="shell">
      <aside class="sidebar">
        <div class="identity">
          <a href="/" class="name">{profile.name}</a>
          <p class="role">{profile.title}</p>
          <p class="place">{profile.location}</p>
        </div>

        {apps.length > 0 && (
          <button type="button" class="launcher-btn" data-track="Apps menüsü" aria-haspopup="dialog" aria-expanded="false" aria-controls="launcher">
            <span class="dots" aria-hidden="true">
              <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
            </span>
            <span class="launcher-text">Apps</span>
            <span class="launcher-count" aria-label={`${apps.length} apps`}>{apps.length}</span>
          </button>
        )}

        <nav aria-label="Site" class="toc">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>

        <ul class="contact" aria-label="Contact">
          <li><a href={`mailto:${contact.emails[0]}`} data-track="E-posta">{contact.emails[0]}</a></li>
          <li><a href={contact.linkedin} rel="noopener" data-track="LinkedIn">LinkedIn</a></li>
          <li><a href={contact.github[0]} rel="noopener" data-track="GitHub">GitHub</a></li>
          <li><a href={contact.newsletter} rel="noopener" data-track="Bülten">Patch Incoming newsletter</a></li>
          {profile.cvUrl && <li><a href={profile.cvUrl} download data-track="CV indirme">Download CV (PDF)</a></li>}
        </ul>

        <div class="sidebar-foot">
          <button type="button" class="theme-toggle" data-track="Tema değiştir" aria-label="Switch colour theme">
            <span class="theme-label">Dark theme</span>
          </button>
          {useGa && <button type="button" class="cookie-settings" data-open-consent>Cookie settings</button>}
          <p class="copy">© {year} mifarosa.com</p>
        </div>
      </aside>

      <main id="content">
        <slot />
      </main>
    </div>

    {apps.length > 0 && (
      <dialog id="launcher" class="launcher" aria-labelledby="launcher-title">
        <div class="launcher-head">
          <h2 id="launcher-title">Apps</h2>
          <button type="button" class="launcher-close" aria-label="Close apps">✕</button>
        </div>
        <p class="launcher-sub">Small tools I built and run. Each opens in its own tab.</p>
        <AppTiles apps={apps} />
      </dialog>
    )}

    {useGa && <ConsentBanner />}

    <script>
      // Theme toggle: remembers the visitor's choice
      const root = document.documentElement;
      const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const label = btn?.querySelector('.theme-label');
      const isDark = () =>
        root.dataset.theme === 'dark' ||
        (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
      const sync = () => { if (label) label.textContent = isDark() ? 'Light theme' : 'Dark theme'; };
      sync();
      btn?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
        sync();
      });

      // Click events for GoatCounter (and Google Analytics when on): elements with data-track use that name;
      // other outbound, mailto and download links get one automatically.
      // Internal links are already counted as page views.
      const trackName = (el: HTMLElement) => {
        if (el.dataset.track) return el.dataset.track;
        if (!(el instanceof HTMLAnchorElement) || !el.href) return null;
        if (el.protocol === 'mailto:') return 'E-posta';
        if (el.hasAttribute('download')) return `İndirme: ${el.pathname.split('/').pop()}`;
        if (el.origin !== location.origin && el.protocol.startsWith('http')) {
          return `Dış link: ${el.hostname.replace(/^www\./, '')}${el.pathname.replace(/\/$/, '')}`;
        }
        return null;
      };
      const trackClick = (e: MouseEvent) => {
        if (e.type === 'auxclick' && e.button !== 1) return;   // middle click opens a tab, right click does not
        const el = (e.target as Element).closest<HTMLElement>('a, button');
        const name = el && trackName(el);
        if (!name) return;
        (window as any).goatcounter?.count?.({ path: name, title: name, referrer: '', event: true });
        (window as any).gtag?.('event', 'tracked_click', { name, transport_type: 'beacon' });
      };
      document.addEventListener('click', trackClick);
      document.addEventListener('auxclick', trackClick);

      // Apps launcher: opens the dialog growing out of the button
      const launchBtn = document.querySelector<HTMLButtonElement>('.launcher-btn');
      const dialog = document.querySelector<HTMLDialogElement>('#launcher');
      if (launchBtn && dialog) {
        const close = () => dialog.close();
        launchBtn.addEventListener('click', () => {
          const r = launchBtn.getBoundingClientRect();
          dialog.style.setProperty('--ox', `${r.left + r.width / 2}px`);
          dialog.style.setProperty('--oy', `${r.top + r.height / 2}px`);
          dialog.showModal();
          launchBtn.setAttribute('aria-expanded', 'true');
        });
        dialog.addEventListener('close', () => launchBtn.setAttribute('aria-expanded', 'false'));
        dialog.querySelector('.launcher-close')?.addEventListener('click', close);
        // Click on the backdrop (outside the panel) or on an app tile closes it
        dialog.addEventListener('click', (e) => {
          const t = e.target as HTMLElement;
          if (t === dialog || t.closest('.app')) close();
        });
      }
    </script>
  </body>
</html>

<style>
  .shell {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 5rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  /* ---------- Sidebar ---------- */
  .sidebar {
    position: sticky; top: 0;
    height: 100vh;
    overflow-y: auto;
    /* side padding leaves room for the launcher glow, which the scroll container would otherwise clip */
    padding: 3.5rem 1.5rem 2rem;
    margin: 0 -1.5rem;
    display: flex; flex-direction: column; gap: 2.25rem;
    /* thin scrollbar that only shows while the sidebar is hovered */
    scrollbar-width: thin;
    scrollbar-color: transparent transparent;
  }
  .sidebar:hover { scrollbar-color: var(--rule) transparent; }
  .sidebar::-webkit-scrollbar { width: 6px; }
  .sidebar::-webkit-scrollbar-thumb { background: transparent; border-radius: 3px; }
  .sidebar:hover::-webkit-scrollbar-thumb { background: var(--rule); }
  .sidebar::-webkit-scrollbar-thumb:hover { background: var(--muted); }

  /* short windows: tighten spacing so the sidebar rarely needs to scroll */
  @media (min-width: 901px) and (max-height: 800px) {
    .sidebar { padding-top: 2rem; padding-bottom: 1rem; gap: 1.25rem; }
    .sidebar .toc a { padding-top: 0.15rem; padding-bottom: 0.15rem; }
  }
  .name {
    display: block;
    color: var(--ink);
    text-decoration: none;
    font-size: 1.3rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .role { margin-top: 0.4rem; color: var(--ink-soft); font-size: 0.95rem; line-height: 1.4; }
  .place { color: var(--muted); font-size: 0.9rem; }

  .toc ul, .contact { list-style: none; }
  .toc a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.85rem;
    border-left: 2px solid var(--rule);
    color: var(--ink-soft);
    text-decoration: none;
  }
  .toc a:hover { color: var(--ink); border-left-color: var(--muted); }
  .toc a[aria-current] { color: var(--accent); border-left-color: var(--accent); font-weight: 500; }

  .contact { font-size: 0.9rem; display: grid; gap: 0.35rem; }
  .contact a { color: var(--ink-soft); overflow-wrap: anywhere; }
  .contact a:hover { color: var(--accent); }

  .sidebar-foot { margin-top: auto; display: grid; gap: 0.75rem; justify-items: start; }
  .theme-toggle {
    font: inherit; font-size: 0.85rem;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
  }
  .theme-toggle:hover { color: var(--ink); border-color: var(--muted); }
  .copy { font-size: 0.8rem; color: var(--muted); }
  .cookie-settings {
    font: inherit; font-size: 0.8rem; color: var(--muted);
    background: none; border: 0; padding: 0; cursor: pointer;
    text-decoration: underline; text-underline-offset: 0.18em;
  }
  .cookie-settings:hover { color: var(--accent); }

  main { padding: 3.5rem 0 6rem; max-width: 46rem; min-width: 0; }

  /* ---------- Apps launcher ---------- */
  .launcher-btn {
    position: relative;
    display: flex; align-items: center; gap: 0.75rem;
    width: 100%;
    font: inherit; font-weight: 700; font-size: 1rem;
    color: #fff;
    background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 55%, #6b3df0));
    border: 0; border-radius: 12px;
    padding: 0.7rem 0.9rem;
    cursor: pointer;
    box-shadow: 0 4px 14px color-mix(in srgb, var(--accent) 35%, transparent);
    transition: transform 0.18s, box-shadow 0.18s;
  }
  :root[data-theme='dark'] .launcher-btn { color: #1a0d13; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme='light']) .launcher-btn { color: #1a0d13; } }
  /* Pulse ring: transform/opacity only (no repaints), a few times after load */
  .launcher-btn::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit;
    border: 2px solid var(--accent);
    opacity: 0;
    animation: launcher-pulse 2.8s ease-out 1s 3;
    pointer-events: none;
  }
  .launcher-btn:hover, .launcher-btn:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .launcher-btn:active { transform: translateY(0) scale(0.98); }
  .dots { display: grid; grid-template-columns: repeat(3, 5px); gap: 3px; }
  .dots i { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .launcher-btn:hover .dots i { animation: dot-wave 0.9s ease-in-out infinite; }
  .launcher-btn:hover .dots i:nth-child(2), .launcher-btn:hover .dots i:nth-child(4) { animation-delay: 0.08s; }
  .launcher-btn:hover .dots i:nth-child(3), .launcher-btn:hover .dots i:nth-child(5), .launcher-btn:hover .dots i:nth-child(7) { animation-delay: 0.16s; }
  .launcher-btn:hover .dots i:nth-child(6), .launcher-btn:hover .dots i:nth-child(8) { animation-delay: 0.24s; }
  .launcher-btn:hover .dots i:nth-child(9) { animation-delay: 0.32s; }
  .launcher-text { flex: 1; text-align: left; }
  .launcher-count {
    min-width: 1.5rem; padding: 0 0.4rem;
    text-align: center; font-size: 0.8rem; line-height: 1.5rem;
    border-radius: 999px; background: rgba(255, 255, 255, 0.25);
  }
  @keyframes launcher-pulse {
    0% { opacity: 0.6; transform: scale(1); }
    70%, 100% { opacity: 0; transform: scale(1.08, 1.35); }
  }
  @keyframes dot-wave {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.6); opacity: 0.7; }
  }

  .launcher {
    --ox: 50%; --oy: 50%;
    margin: auto;
    width: min(40rem, calc(100vw - 2rem));
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    padding: 1.5rem;
    background: var(--bg); color: var(--ink);
    border: 1px solid var(--rule); border-radius: 18px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
    /* A small grow from the button plus a fade: only transform and opacity animate */
    transform-origin: var(--ox) var(--oy);
    opacity: 0; transform: scale(0.94);
    transition: opacity 0.18s ease-out, transform 0.18s ease-out, overlay 0.18s allow-discrete, display 0.18s allow-discrete;
  }
  .launcher[open] { opacity: 1; transform: none; }
  @starting-style { .launcher[open] { opacity: 0; transform: scale(0.94); } }
  /* Plain dim, no blur: blurring the whole page every frame is what made opening stutter */
  .launcher::backdrop {
    background: rgba(10, 12, 16, 0);
    transition: background 0.18s ease-out, overlay 0.18s allow-discrete, display 0.18s allow-discrete;
  }
  .launcher[open]::backdrop { background: rgba(10, 12, 16, 0.6); }
  @starting-style { .launcher[open]::backdrop { background: rgba(10, 12, 16, 0); } }
  .launcher-head { display: flex; align-items: center; justify-content: space-between; }
  .launcher-head h2 { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.01em; }
  .launcher-sub { color: var(--muted); font-size: 0.95rem; margin: 0.25rem 0 1.25rem; }
  .launcher-close {
    font: inherit; font-size: 1rem; line-height: 1;
    width: 2.2rem; height: 2.2rem; border-radius: 50%;
    color: var(--ink-soft); background: var(--surface);
    border: 1px solid var(--rule); cursor: pointer;
  }
  .launcher-close:hover { color: var(--accent); border-color: var(--accent); }
  .launcher[open] :global(.apps li) { animation: tile-in 0.22s both ease-out 0.05s; }
  .launcher[open] :global(.apps li:nth-child(2)) { animation-delay: 0.08s; }
  .launcher[open] :global(.apps li:nth-child(n+3)) { animation-delay: 0.11s; }
  @keyframes tile-in { from { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .launcher-btn::after, .launcher-btn:hover .dots i, .launcher[open] :global(.apps li) { animation: none; }
    .launcher, .launcher::backdrop, .launcher-btn { transition: none; }
  }

  /* ---------- Small screens: sidebar becomes a header ---------- */
  @media (max-width: 900px) {
    .shell { grid-template-columns: 1fr; gap: 0; padding: 0 1.25rem; }
    .sidebar {
      position: static; height: auto; overflow: visible;
      padding: 2rem 0 1.25rem;
      margin: 0;
      gap: 1.25rem;
      border-bottom: 1px solid var(--rule);
    }
    .toc ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem; }
    .toc a { padding: 0.25rem 0; border-left: none; border-bottom: 2px solid transparent; }
    .toc a[aria-current] { border-bottom-color: var(--accent); }
    .contact { display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem; }
    .sidebar-foot { margin-top: 0; }
    .copy { display: none; }
    main { padding-top: 2rem; }
    .launcher-btn { width: auto; align-self: flex-start; }
    .launcher { width: 100vw; max-width: 100vw; margin: auto 0 0; border-radius: 18px 18px 0 0; max-height: 85vh; transform: translateY(24px); }
    @starting-style { .launcher[open] { opacity: 0; transform: translateY(24px); } }
  }
</style>
